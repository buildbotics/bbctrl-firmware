// Rev, Stop and Fwd, then the measured speed
// Wraps the speed box onto its own line when the column is narrow
.spindle-control
  display flex
  flex-wrap wrap
  gap gutter
  align-items stretch

  .pure-button
    flex 1 1 4.5em
    padding 0.5em 0
    font-weight 600

    display inline-flex
    align-items center
    justify-content center

    .bi
      width 1em
      height 1em
      margin-right 0.35em

    // Lit while the spindle turns that way
    &.active:not([disabled])
      color #fff
      background ok-color
      border-color ok-color

  .rpm
    flex 1.5 1 7em
    display flex
    align-items center
    padding 0 0.5em
    border 1px solid border-color
    border-radius radius
    background surface
    cursor text

    &:focus-within
      border-color accent

    &.invalid
      border-color err-color
      background err-tint

    input
      flex 1
      min-width 0
      width 100%
      padding 0
      border 0
      outline 0
      background transparent
      box-shadow none
      text-align right
      font-family mono-font
      font-size 14pt

    .units
      margin-left 0.3em
      font-size 10pt
      color text-muted
