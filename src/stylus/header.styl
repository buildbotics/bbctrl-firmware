header-height = 40px

// One compact row: name and version on the left, then attribution and the
// logo in the right corner
.header
  padding 0 0.5em
  border 0
  background chrome
  color chrome-text
  border-bottom 2px solid accent

  .header-content
    height header-height
    display flex
    align-items center
    gap 1em
    overflow hidden

  // Shrinks no narrower than the name, which never gets covered
  .banner
    flex 1
    margin 0
    display flex
    align-items center
    gap 0.6em
    white-space nowrap

    .banner-text
      display flex
      align-items baseline
      gap 0.75em
      min-width 0

    .title
      flex none
      font-size 16pt
      font-weight 300
      letter-spacing 0.02em

      .left
        color #fff
        font-weight 700
      .right
        color accent

      .fa
        font-size 70%
        margin-left 0.5em

    .subtitle
      font-size 10pt
      color chrome-muted
      overflow hidden
      text-overflow ellipsis

      b
        color chrome-text

  .copyright
    flex 0 1 auto
    min-width 0
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
    font-size 8pt
    color chrome-muted
    opacity 0.8
    text-decoration none

    &:hover
      color accent
      opacity 1

  .logo
    flex none
    height 18px

@media only screen and (max-width collapse-width)
  // Room for the menu button
  .header .header-content
    margin-left 40px
