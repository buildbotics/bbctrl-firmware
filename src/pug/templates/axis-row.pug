script#axis-row-template(type="text/x-template")
  tr.axis(:class="axis.klass", :title="axis.title")
    th.name {{name}}
    td.zero
      button.pure-button.square(:disabled="!is_idle", @click="zero",
        title="Zero {{name}} axis in the current offset.")
        bi-icon(name="zero-square-fill")
    td.position(:class="{clickable: is_idle}", @click="set_position",
      title="Click to set {{name}} axis position.")
      unit-value(:value="axis.pos", precision=4)
    td.state(:class="'state-' + axis.stateClass",
      :title="axis.state + ': ' + axis.title")
      bi-icon(:name="axis.icon")
    td.home
      button.pure-button.square(:disabled="!is_idle", @click="home",
        :class="'home-' + axis.stateClass", title="Home {{name}} axis.")
        bi-icon(name="house-door-fill")

      dialog(v-ref:set-position,
        :buttons="axis.homed ? 'Cancel Unhome Set' : 'Cancel Set'",
        :header="'Set ' + name + ' axis position'")
        div(slot="body")
          .pure-form
            .pure-control-group
              label Position
              input(v-model="position",
                @keyup.enter="$refs.setPosition.close('set')")

      dialog(v-ref:set-home, buttons="Cancel Set",
        :header="'Manually home ' + name + ' axis'")
        div(slot="body")
          p Set axis absolute position.
          .pure-form
            .pure-control-group
              label Absolute
              input(v-model="position",
                @keyup.enter="$refs.setHome.close('set')")
