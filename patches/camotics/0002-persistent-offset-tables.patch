+
+// Load a stored offset from outside the program.  Unlike G10 this does not
+// publish an offset table change, the caller already has the value.
+void ControllerImpl::setCoordSystemOffset(unsigned cs, char axis, double value,
+                                          Units units) {
+  if (cs < 1 || 9 < cs) THROW("Invalid coordinate system number " << cs);
+  machine.set(COORD_SYSTEM_ADDR(cs, Axes::toIndex(axis)), value, units);
+  offsetParamChanged = true;
+}
