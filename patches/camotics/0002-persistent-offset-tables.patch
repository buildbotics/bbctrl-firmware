+  char parseAxis(const char *axis) {
+    if (!axis[0] || axis[1] || !GCode::Axes::isAxis(axis[0]))
+      THROW("Invalid axis '" << axis << "'");
+    return std::toupper(axis[0]);
+  }
+
+
+  // Offsets are exchanged with the host in millimeters
+  PyObject *_set_coord_offset(PyPlanner *self, PyObject *args) {
+    try {
+      unsigned cs;
+      const char *axis;
+      double value;
+
+      if (!PyArg_ParseTuple(args, "Isd", &cs, &axis, &value)) return 0;
+
+      self->planner->getController()
+        .setCoordSystemOffset(cs, parseAxis(axis), value, GCode::Units::METRIC);
+      Py_RETURN_NONE;
+
+    } CATCH_PYTHON;
+
+    return 0;
+  }
+
+
+  PyObject *_set_tool_offset(PyPlanner *self, PyObject *args) {
+    try {
+      unsigned tool;
+      const char *axis;
+      double value;
+
+      if (!PyArg_ParseTuple(args, "Isd", &tool, &axis, &value)) return 0;
+
+      self->planner->getController()
+        .setToolOffset(tool, parseAxis(axis), value, GCode::Units::METRIC);
+      Py_RETURN_NONE;
+
+    } CATCH_PYTHON;
+
+    return 0;
+  }
+
+
+  // Returns {"coord_systems": {"1": {"x": mm, ...}, ... "9": {...}},
+  //          "tools": {"<number>": {"x": mm, ...}, ...}}
+  PyObject *_get_offsets(PyPlanner *self) {
+    try {
+      GCode::ControllerImpl &ctrl = self->planner->getController();
+      PyJSONSink sink;
+
+      sink.beginDict();
+
+      sink.insertDict("coord_systems");
+      for (unsigned cs = 1; cs <= 9; cs++) {
+        sink.insertDict(cb::String(cs));
+        for (const char *axis = GCode::Axes::AXES; *axis; axis++)
+          sink.insert(std::string(1, std::tolower(*axis)),
+                      ctrl.getCoordSystemOffset(cs, *axis,
+                                                GCode::Units::METRIC));
+        sink.endDict();
+      }
+      sink.endDict();
+
+      sink.insertDict("tools");
+      for (auto &entry: ctrl.getTools()) {
+        const GCode::Tool &tool = entry.second;
+        GCode::Units units = tool.getUnits();
+
+        sink.insertDict(cb::String(entry.first));
+        for (const char *axis = GCode::Axes::AXES; *axis; axis++)
+          sink.insert(std::string(1, std::tolower(*axis)),
+                      GCode::convert(units, GCode::Units::METRIC,
+                                            tool.get(*axis)));
+        sink.endDict();
+      }
+      sink.endDict();
+
+      sink.endDict();
+      return sink.getRoot();
+
+    } CATCH_PYTHON;
+
+    return 0;
+  }
+
