script#view-settings-template(type="text/x-template")
  div
    nav.navbar
      a.nav-item(href="#settings:general") General

      nav-item
        | Motors
        .fa.fa-caret-down

        nav-menu
          a.nav-item(v-for="motor in [0, 1, 2, 3]",
            :href="'#settings:motor:' + motor") Motor {{motor}}

      a.nav-item(href="#settings:tool") Tool
      a.nav-item(href="#settings:io") I/O
      a.nav-item(href="#settings:network") Network
      a.nav-item(href="#settings:admin") Admin

      .actions
        nav-item.login-user(v-if="$root.user",
          :title="$root.admin ? 'Logged in with admin access' : 'Logged in'")
          span.fa(:class="$root.admin ? 'fa-key' : 'fa-user'")
          |  {{$root.user}}
          .fa.fa-caret-down

          nav-menu
            nav-item(@click="$root.change_password($root.user)")
              .fa.fa-key
              span Password

            nav-item(v-if="!$root.admin", @click="$root.login('admin')")
              .fa.fa-sign-in
              span Login

            nav-item(@click="$root.logout")
              .fa.fa-sign-out
              span Logout

        bbutton(v-if="!$root.user", @click="$root.login()", text="Login",
          success, title="Login to unlock protected settings")

        bbutton(v-if="$root.admin", :success="modified",
          :disabled="!modified", @click="save", title="Save settings",
          text="Save")

    // Nothing under Settings can be changed without admin access
    .settings-view
      admin-gate(v-if="!$root.admin")

      div(v-if="$root.admin && view", :is="'settings-' + view",
        :index="index", :config="config", :template="template",
        :state="state", keep-alive)
