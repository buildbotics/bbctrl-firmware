body, #layout
  overflow hidden
  height 100vh

#layout
  display flex

[v-cloak]
  display none

.content
  padding 0

button
  white-space nowrap

  .fa
    margin-right 0.25em

@font-face
  font-family password
  src url('/fonts/password.ttf')

input.password
  font-family password

button-hover = linear-gradient(transparent, #0000000a 40%, #00000014)
limit-width = 1200px
sidebar-width = 110px
footer-height = 84px
gutter = 0.5em // Between panels and around the page
collapse-width = 810px

