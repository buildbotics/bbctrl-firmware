script#overrides-template(type="text/x-template")
  .overrides
    .override.override-speed.slider-row(title="Spindle speed override.")
      label Speed
      input.segmented-slider(type="range", v-model="speed", number, min="0.1",
        max="2", step="0.1", @change="override_speed")
      span.value {{speed | percent 0}}
      button.pure-button.reset(@click="reset_speed", :disabled="speed == 1",
        title="Reset the spindle speed override to 100%")
        bi-icon(name="arrow-clockwise")

    //- The AVR stores the feed override but its motion code does not apply
    //- it yet, so the slider would do nothing
    .override.override-feed.slider-row(
      title="Not supported by the controller yet.")
      label Feed
      input.segmented-slider(type="range", v-model="feed", number, min="0.1",
        max="1.2", step="0.1", disabled)
      span.value {{feed | percent 0}}
      button.pure-button.reset(disabled)
        bi-icon(name="arrow-clockwise")
