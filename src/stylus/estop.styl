@keyframes blink
  50%
    fill #ff9d00

.estop
  width 130px
  transition 250ms

  &.active .ring
    animation blink 2s step-start 0s infinite

  &:hover .button circle
    fill #b72424 !important

  svg
    cursor pointer

    .button:hover
      filter brightness(120%)


// The docked E-stop must never be covered: fixed in the bottom left corner,
// even when the menu collapses, and above every dialog mask (.dialog-mask is
// z-index 1000) and the connection overlay so it stays visible and clickable.
#estop-dock
  position fixed
  left 0
  bottom 0
  z-index 1001
  box-sizing border-box
  width sidebar-width
  height sidebar-width
  display flex
  align-items center
  justify-content center
  background chrome
  border-right 1px solid #000

  svg
    width 96px
    height 96px

// Bottom navigation: the right corner instead, after the tabs
#layout.nav-bottom #estop-dock
  left auto
  right 0
  width footer-height
  height footer-height
  border-top 1px solid #000
  border-right 0
  border-left 1px solid #000

  svg
    width (footer-height - 8px)
    height (footer-height - 8px)
