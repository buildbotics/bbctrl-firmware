script#jog-control-template(type="text/x-template")
  .jog-control(:class="{disabled: disabled}")
    .jog-axes.segmented
      button.pure-button(v-for="name in axes",
        class="axis-{{name.toLowerCase()}}", :class="{active: axis == name}",
        :disabled="!enabled[name.toLowerCase()] || !!held",
        @click="select_axis(name)", :title="'Jog the ' + name + ' axis'")
        | {{name}}

    .jog-mode.segmented
      button.pure-button(:class="{active: !step}", @click="step = false",
        :disabled="!!held", title="Move while the button is held") Cont
      button.pure-button(:class="{active: step}", @click="step = true",
        :disabled="!!held", title="Move a fixed distance per press") Step

    .jog-feed.slider-row(v-if="!step")
      label Jog Feed
      input.segmented-slider(type="range", v-model="feed", number, min=10,
        max=100, step=10)
      span.value {{feed}}%

    .jog-increments.segmented(v-else)
      button.pure-button(v-for="inc in increments",
        :class="{active: inc_index == $index}", @click="inc_index = $index",
        :title="'Step ' + inc + ' ' + units") {{inc}}

    .jog-buttons
      button.pure-button(:disabled="disabled || !axis_enabled",
        @pointerdown="press(-1, $event)", @pointerup="release",
        @pointercancel="release", @lostpointercapture="release",
        @contextmenu="ignore", :title="'Jog ' + axis + ' negative'")
        | {{axis}} &minus;
      button.pure-button(:disabled="disabled || !axis_enabled",
        @pointerdown="press(1, $event)", @pointerup="release",
        @pointercancel="release", @lostpointercapture="release",
        @contextmenu="ignore", :title="'Jog ' + axis + ' positive'")
        | {{axis}} +
