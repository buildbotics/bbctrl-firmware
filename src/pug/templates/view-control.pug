script#view-control-template(type="text/x-template")
  #control
    .top-panels
      .program-panel.pure-form
        .filename(:title="active.path") {{active.filename || 'No program'}}

        .gcode
          textarea.gcode-view(v-el:gcode-view)

        .mdi(title="Manual command entry.  Up and down recall history.")
          input(v-model="mdi", :disabled="!can_mdi", placeholder="MDI",
            @keyup.enter="submit_mdi", @keydown.up="history_back($event)",
            @keydown.down="history_forward($event)")

          bbutton(:disabled="!can_mdi", :class="{'attention': is_holding}",
            title="{{is_running ? 'Pause' : 'Send'}} command.",
            @click="mdi_start_pause", :icon="is_running ? 'pause' : 'play'")

      //- The 3D view with the macros in a row below it.  The program and
      //- MDI keep the full height beside them.
      .viewer-column
        .viewer-panel
          nav.navbar
            //- Left: what the panel shows
            nav-item.viewer-tab(v-if="$root.webGLSupported",
              :class="{active: viewer_tab == '3d'}",
              @click="viewer_tab = '3d'", title="3D view of the program")
              bi-icon(name="box")
              span 3D View

            nav-item.viewer-tab(:class="{active: viewer_tab == 'messages'}",
              @click="viewer_tab = 'messages'", title="Controller messages")
              bi-icon(name="chat-left-text")
              span Messages
              span.unseen(v-if="unseen_level", :class="'unseen-' + unseen_level",
                :title="'New ' + unseen_level + ' messages'")

            nav-item.viewer-tab(:class="{active: viewer_tab == 'camera'}",
              @click="viewer_tab = 'camera'", title="Live camera feed")
              bi-icon(name="camera-video")
              span Camera

            //- Right: options for the shown tab
            .viewer-options(v-show="viewer_tab == '3d'")
              nav-item
                | View
                .fa.fa-caret-down
                nav-menu
                  nav-item(@click="toggle('tool')")
                    .fa(:class="show.tool ? 'fa-check' : ''")
                    span Show Tool

                  nav-item(@click="toggle('axes')")
                    .fa(:class="show.axes ? 'fa-check' : ''")
                    span Show Axes

                  nav-item(@click="toggle('grid')")
                    .fa(:class="show.grid ? 'fa-check' : ''")
                    span Show Grid

                  nav-item(@click="toggle('dims')")
                    .fa(:class="show.dims ? 'fa-check' : ''")
                    span Show Bounds

                  nav-item(@click="toggle('intensity')")
                    .fa(:class="show.intensity ? 'fa-check' : ''")
                    span LASER Raster

              nav-item
                | Snap
                .fa.fa-caret-down
                nav-menu
                  nav-item.snap(v-for="name in snaps" @click="snap(name)")
                    img(:src="'images/' + name + '.png'")
                    span {{name}}

              nav-item(@click="$refs.helpDialog.open()") Help

            .viewer-options(v-show="viewer_tab == 'camera'")
              nav-item(@click="$root.crosshair = !$root.crosshair",
                title="Show or hide the crosshair overlay")
                .fa(:class="$root.crosshair ? 'fa-check-square-o' : 'fa-square-o'")
                | Crosshair

          //- Tab content; the overlays position against this, not the header
          .viewer-body
            //- Kept alive while hidden: the 3D scene is expensive to rebuild
            .viewer-3d(v-if="$root.webGLSupported", v-show="viewer_tab == '3d'")
              loading-message(v-if="loading", :progress="active.progress")
                p(slot="body").
                  Simulating program to check for errors, calculating timing and
                  generating 3D view. Please wait...

              viewer-help-dialog(v-ref:help-dialog)

              path-viewer(v-ref:viewer, :toolpath="toolpath", :state="state",
                :config="config")

            .viewer-messages(v-show="viewer_tab == 'messages'")
              console

            //- Mounted only while shown: each open feed takes one of the
            //- controller's limited camera client slots
            .viewer-camera(v-if="camera_live")
              video

            //- Overlays on the 3D view and camera, which have room for them
            .viewer-state(v-show="viewer_tab != 'messages'",
              :data-state="state_class", :class="{attention: highlight_state}")
              | {{mach_state || 'CONNECTING'}}

            .viewer-footer(v-show="viewer_tab != 'messages'")
              .viewer-message(:class="{none: !message, attention: highlight_state}",
                @click="viewer_tab = 'messages'", title="Show all messages")
                | {{message ? message.replace(/^#/, '') : 'No messages'}}

              table.viewer-readout
                tr
                  th Velocity
                  td
                    unit-value(:value="state.v", precision="2", unit="",
                      iunit="", scale="0.0254")
                    | {{metric ? ' m/min' : ' IPM'}}

                tr
                  th Feed
                  td
                    unit-value(:value="state.feed", precision="2", unit="",
                      iunit="")
                    | {{metric ? ' mm/min' : ' IPM'}}

                tr
                  th Speed
                  td
                    | {{state.speed || 0 | fixed 0}}
                    span(v-if="!isNaN(state.s)")  ({{state.s | fixed 0}})
                    = ' RPM'

          //- Below the tabs' content rather than over it, so it hides nothing
          .viewer-progress(:class="{simulating: simulating}")
            .bar(:style="'width:' + (progress || 0) * 100 + '%'")
            .progress-text
              span.percent.
                {{simulating ? 'Simulating' : 'Progress'}}
                {{(progress || 0) | percent}}
              span.remaining(title="Run time (days:hours:mins:secs)").
                #[span(v-if="remaining") {{remaining | time}} of]
                {{toolpath.time || 0 | time}}
              span.eta(title="Estimated completion time based on remaining time").
                ETA {{eta || '--'}}

        .macros
          //- Plain buttons: bbutton would guess an icon from the name and
          //- leave an empty gap before it
          button.pure-button.macro(v-for="macro in config.macros",
            v-if="macro.path", @click="run_macro($index + 1)",
            title="Run macro {{$index + 1}} {{macro.name}}\n{{macro.path}}",
            :style="{'background-color': macro.color}")
            | {{macro.name || ($index + 1)}}

          bbutton.macro(@click="goto('#settings:macros')", icon="cog",
            text="Macros", title="Go to macro settings")

    .dro-row
      .run-column
        .run-panel
          //- One cycle button: Cycle Start when idle or held, Feed Hold while
          //- moving
          bbutton.cycle.button-success(v-show="!program_active",
            title="Run the program.", @click="run", icon="play",
            text="Cycle Start", :disabled="!active.path || !is_ready")

          bbutton.cycle.button-warning(v-show="is_running || is_stopping",
            title="Pause the machine.", @click="pause", icon="pause",
            text="Feed Hold", :disabled="is_stopping")

          bbutton.cycle.button-success(v-show="is_holding",
            title="Resume the program.", @click="unpause", icon="play",
            text="Cycle Start")

          .run-options
            bbutton(title="Not supported by the controller yet.",
              icon="step-forward", text="Single Block", disabled)

            bbutton(:class="{'button-secondary': m01_break}",
              title="Stop at each M01 in the program until turned off.",
              @click="toggle_m01_break",
              :icon="m01_break ? 'check-square-o' : 'square-o'",
              text="M01 Break")

            bbutton.button-error(title="Stop the program.", @click="stop",
              icon="stop", text="Stop", :disabled="!program_active")

            bbutton(title="Clear an E-stop, or stop and rewind the program.",
              @click="reset", icon="undo", text="Reset",
              :disabled="!can_reset")

        overrides(:state="state", :template="template")

        .modal-status(title="Active modes, as reported by the planner")
          span.modal-label Active
          span.modal-code(v-for="c in modal_codes", :title="c.title")
            | {{c.code}}

      .axes-column
        table.axes
          tr(:class="axes.klass")
            th.name Axis
            th.zero Zero
            th.position Position
            th.state State
            th.home
              button.pure-button.square(title="Home all axes.",
                @click="home_all", :disabled="!is_idle",
                :class="'home-' + axes.stateClass")
                bi-icon(name="house-door-fill")

          each axis in 'xyzabc'
            tr(is="axis-row", :axis=axis, v-if=`${axis}.enabled`)

        .tool-panel
          span.tool-label Tool:
          span.tool-number(title="Current tool number") {{state.tool || 0}}
          button.pure-button.tool-change(@click="change_tool",
            :disabled="!is_idle",
            title="Run the tool change GCode from Settings, as M6 would.")
            | Change Tool

          dialog(v-ref:tool-change, header="Change tool", width="320px",
            :buttons="[{text: 'Cancel'}, {text: 'Change', disabled: !new_tool_valid}]")
            div(slot="body")
              p.
                Runs the tool change GCode from Settings, the same as an M6
                in a program.
              .pure-form
                .pure-control-group
                  label Tool number
                  input(v-model="new_tool", inputmode="numeric", focus,
                    @keyup.enter="confirm_tool_change")

      .manual-panel
        jog-control(
          :enabled="{x: x.enabled, y: y.enabled, z: z.enabled, a: a.enabled}",
          :metric="metric", :disabled="is_running")

        hr

        spindle-control(:state="state", :disabled="!can_mdi")
