script#spindle-control-template(type="text/x-template")
  .spindle-control
    button.pure-button(:class="{active: reverse}",
      :disabled="disabled || invalid", @click="start('M4')",
      title="Start the spindle in reverse at the speed typed (M4)")
      bi-icon(name="arrow-counterclockwise")
      span Rev
    button.pure-button(:disabled="disabled", @click="send('M5')",
      title="Stop the spindle (M5)") Stop
    button.pure-button(:class="{active: forward}",
      :disabled="disabled || invalid", @click="start('M3')",
      title="Start the spindle forward at the speed typed (M3)")
      bi-icon(name="arrow-clockwise")
      span Fwd

    label.rpm(:class="{invalid: invalid}",
      :title="rpm_title")
      input(v-model="target", inputmode="numeric", placeholder="S",
        :disabled="disabled", @input="editing = true")
      span.units RPM
