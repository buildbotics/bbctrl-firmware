#!/usr/bin/env bash
#
# pre-push hook: block a push when the fast part of the CI gate fails.
# Lint and unit tests only; the firmware and image builds are left to CI.
#
# Uses the project venv when one exists, so a pytest or pylint elsewhere on
# PATH (e.g. a Windows install under WSL) is not picked up by mistake.
#
# Activate once per clone:  git config core.hooksPath .githooks
# Emergency bypass:         git push --no-verify
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if [ -f .venv/bin/activate ]; then
  # shellcheck disable=SC1091
  . .venv/bin/activate
fi

echo "pre-push: lint + tests ...  (emergency bypass: --no-verify)"

if ! make lint; then
  echo "pre-push: lint failed, push aborted." >&2
  exit 1
fi

if ! make test; then
  echo "pre-push: tests failed, push aborted." >&2
  exit 1
fi

echo "pre-push: lint + tests passed."
