doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")

    title RONtrol - CNC Control

    style: include ../static/css/pure-min.css

    style: include ../static/css/font-awesome.min.css
    style: include ../static/css/Audiowide.css
    style: include ../static/css/codemirror.css
    style: include:stylus ../stylus/style.styl


  body(v-cloak)
    #overlay(v-if="status != 'connected'")
      span {{login_required ? 'login required' : status}}
    #layout(:class="'view-' + currentView + '-page nav-' + navPosition")
      #menuLink.menu-link(href="#menu"): span

      #menu
        .pure-menu
          ul.pure-menu-list
            li.pure-menu-heading(:class="{active: currentView == 'control'}")
              a.pure-menu-link(href="#control")
                .fa.fa-sliders
                span Control

            li.pure-menu-heading(:class="{active: currentView == 'viewer'}",
              v-if="$root.webGLSupported")
              a.pure-menu-link(href="#viewer")
                .fa.fa-cube
                span 3D View

            li.pure-menu-heading(:class="{active: currentView == 'probing'}")
              a.pure-menu-link(href="#probing")
                .fa.fa-crosshairs
                span Probing

            li.pure-menu-heading(:class="{active: currentView == 'offsets'}")
              a.pure-menu-link(href="#offsets")
                .fa.fa-arrows
                span Offsets

            li.pure-menu-heading(:class="{active: currentView == 'editor'}")
              a.pure-menu-link(href="#editor")
                .fa.fa-pencil-square-o
                span Editor

            li.pure-menu-heading(:class="{active: currentView == 'files'}")
              a.pure-menu-link(href="#files")
                .fa.fa-folder-open
                span Files

            li.pure-menu-heading(:class="{active: currentView == 'settings'}")
              a.pure-menu-link(href="#settings")
                .fa.fa-cog
                span Settings

      #main
        .header
          .header-content
            .banner
              img(src="/images/rontrol-logo-light.png", alt="RONtrol")
              .banner-text
                .title
                  span.left RON
                  span.right trol
                  .fa.fa-thermometer-full(class="error",
                    v-if="80 <= state.rpi_temp",
                    title="Raspberry Pi temperature too high.")
                .subtitle
                  | CNC Controller #[b {{state.demo ? 'Demo ' : ''}}]
                  | v{{config.version}}
                  a.upgrade-version(v-if="show_upgrade", href="#settings:admin")
                    | Upgrade to v{{latestVersion}}
                  .fa.fa-check(v-if="!show_upgrade && latestVersion",
                    title="Firmware up to date")
                  a.copyright(href="https://buildbotics.com", target="_blank",
                    title="Buildbotics: original firmware, manual and forum")
                    | Based on Buildbotics firmware © 2015 - 2026 Buildbotics LLC,
                    | CERN-OHL-S v2


            .header-tools
              .camera-thumb(@click="open_camera", title="Open camera")
                video(:reload-on-click="false")
              bbutton.camera-button(icon="video-camera", title="Open camera",
                @click="open_camera")
              .estop(:class="{active: state.es}"): estop(@click="estop")

        .content(class="view-{{currentView}}")
          component(:is="'view-' + currentView", :config="config",
            :template="template", :state="state", keep-alive)

    file-dialog(v-ref:file-dialog, :locations="state.locations")
    upload-dialog(v-ref:uploader)
    dialog(v-ref:dialog)

    dialog.error-message(v-ref:error-message, width="800px")
      div(slot="header")
        .estop(:class="{active: state.es}"): estop(@click="estop")
        h3 ERROR: {{errorMessage}}

      div(slot="body")
        console

        bbutton(@click="block_error_dialog", icon="ban", text="Stop")
        label showing errors for
        input(style="width: 50px", v-model="errorTimeout", number)
        label seconds.

    dialog.camera-dialog(v-ref:camera-dialog, header="Camera", width="960px")
      div(slot="body")
        video(v-if="cameraOpen")

      div(slot="footer")
        bbutton(@click="crosshair = !crosshair", text="Crosshair",
          :icon="crosshair ? 'check-square-o' : 'square-o'",
          title="Show or hide the crosshair overlay")
        bbutton.pure-button-primary(@click="$refs.cameraDialog.close('close')",
          text="Close")

    dialog(v-show="popupMessages.length", v-ref:popup-messages,
      header="GCode messages", :click-away="false")
      div(slot="body")
        p(v-for="msg in popupMessages", track-by="$index") {{msg}}

      div(slot="footer")
        bbutton.button-success(v-if="state.xx != 'HOLDING'",
          @click="close_messages('ok')", text="Ok")

        div(v-if="state.xx == 'HOLDING'")
          bbutton(@click="close_messages('stop')", icon="stop", text="Stop")
          bbutton(@click="close_messages('continue')", icon="play",
            text="Continue")

    dialog(v-ref:login-dialog, header="Login", icon="question", width="400px",
      buttons="Login", :click-away="!login_required")

      div(slot="body")
        p.error(v-if="login_error") {{login_error}}
        p(v-if="session_expired") Your session expired.

        p
          | Log in as a web interface user or as #[b admin] with the system
          | password, the same one used for SSH.

        .pure-form.pure-form-aligned
          .pure-control-group
            label(for="user") User
            input(name="user", v-model="login_user", focus,
              @keyup.enter="$refs.loginDialog.close('login')",
              autocomplete="username")

          .pure-control-group
            label(for="password") Password
            input.password(name="password", v-model="password", focus,
              @keyup.enter="$refs.loginDialog.close('login')",
              autocomplete="off")

    dialog(v-ref:password-dialog, header="Change password", icon="key",
      width="400px", buttons="Cancel Set")

      div(slot="body")
        p.error(v-if="password_error") {{password_error}}

        p(v-if="system_password")
          | This is the controller's system password.  It is also used for SSH
          | and #[code sudo].

        .pure-form.pure-form-aligned
          .pure-control-group(v-if="password_user == user")
            label(for="current") Current Password
            input.password(name="current", v-model="password_current", focus,
              autocomplete="current-password")

          .pure-control-group
            label(for="pass1") New Password
            input.password(name="pass1", v-model="password", focus,
              autocomplete="new-password")

          .pure-control-group
            label(for="pass2") Repeat Password
            input.password(name="pass2", v-model="password2",
              autocomplete="off",
              @keyup.enter="$refs.passwordDialog.close('set')")

          .pure-control-group
            label
            bbutton(@click="generate_passphrase", icon="refresh",
              text="Generate", title="Generate a random passphrase")

          .pure-control-group(v-if="generated")
            label Passphrase
            span.generated {{generated}}

    #templates: include ../../build/templates.pug
    iframe#download-target(style="display:none")

    script: include ../static/js/jquery-1.11.3.min.js
    script: include ../static/js/vue.js
    script: include ../static/js/sockjs.min.js
    script: include ../static/js/three.min.js
    script: include ../static/js/chart-2.9.3.min.js
    script: include ../static/js/chart.bundle-2.9.3.min.js
    script: include:browserify ../js/main.js
    script: include ../static/js/codemirror.js
    script: include ../static/js/codemirror-javascript.js
    script: include ../static/js/jscolor.min.js
