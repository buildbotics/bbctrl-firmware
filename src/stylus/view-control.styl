.view-control
  #control
    display flex
    flex-direction column
    gap gutter

    .top-panels
      display flex
      gap gutter
      height 60vh
      min-height 400px

    .info-blocks
      display grid
      grid-template-columns auto auto auto
      gap gutter

  table
    border-collapse collapse
    td, th
      border 1px solid border-color
  table.axes, table.info
    border-collapse separate
    border-spacing 0
    card()
    overflow hidden
    td, th
      border 0
      border-bottom 1px solid border-color
    tr:last-child td, tr:last-child th
      border-bottom 0
  .axes
    .axis-x .name
      color #ff5a52
    .axis-y .name
      color #3ccf6e
    .axis-z .name
      color #4ea3ff
    .axis-a .name
      color #f80

    .axis-b .name
      color #0ff

    .axis-c .name
      color #f0f

    td, th
      padding 4px 8px
      white-space nowrap
    th
      text-align center
      vertical-align bottom
      background chrome-2
      color chrome-text
      font-weight 600
      font-size 10pt
      text-transform uppercase
      letter-spacing 0.05em
    td
      text-align right
      font-family mono-font
    .homed
      background-color ok-tint
      color text-color
    .warn
      background-color warn-tint
      color text-color
    .error
      background-color err-tint
      color text-color
    .axis
      .name
        text-transform capitalize

      .name
        font-family ui-font
        font-weight 700
        text-align center
      .name, .position
        font-size 26pt
        line-height 30pt
      .position
        width 99%

      td.state
        text-align left

        .fa
          font-size 140%
          margin-left 2px
          margin-right 6px

      .absolute, .offset
        min-width 6em

    tr:nth-child(1) th.actions
      text-align right

  .jog svg
    user-select none
    -webkit-touch-callout none
    -webkit-user-select none
    -khtml-user-select none
    -moz-user-select none
    -ms-user-select none

    text
      font-family Sans
      font-weight bold
      stroke transparent
      fill text-color
    .button
      cursor pointer
      stroke chrome-3
      &:hover
        stroke accent
      path
        overflow visible

    .house
      stroke chrome
      fill chrome
    .ring
      cursor pointer
      overflow visible

      .button
        stroke transparent
        &:hover
          stroke accent
        text
          font-size 10pt
          text-anchor middle

  .macros
    display grid
    grid-template-columns repeat(auto-fill, minmax(9em, 1fr))
    gap gutter
    padding 0

    .macro
      text-align left
      overflow hidden
      text-overflow ellipsis
      white-space nowrap
      min-height 3.25em
      padding 0.5em 0.75em
      font-weight 600
      &:hover
        background-image button-hover

      .fa
        margin-right 0.25em

  .info
    empty-cells show

    th, td
      height 1.75em
      padding 3px 10px
      text-align right
      overflow hidden
      text-overflow ellipsis
      white-space nowrap

    th
      min-width 5.25em
      width 5.25em
      text-align left
      color text-muted
      font-weight 600
      background surface-alt
    td
      min-width 8em
      width 100%

    .progress
      height 1.75em

      label
        float right

      .bar
        height 1.75em
        background accent
        border-radius 3px
  .toolbar
    display flex
    flex-wrap wrap
    clear both
    padding 0 0.125em

    > *
      margin 0.25em 0.125em

    .filename
      flex 1
      text-align right

  .tabs
    section
      min-height 500px
      overflow-x hidden
      overflow-y auto
      padding 0
      margin 0

  .program-panel, .viewer-panel
    card()
    overflow hidden
    display flex
    flex-direction column
    min-width 0

  .program-panel
    flex 0 0 25%

    // Without WebGL there is no 3D view to share the row with
    &:only-child
      flex 1

    .filename
      padding 0 0.5em 0.25em
      color text-muted
      overflow hidden
      text-overflow ellipsis
      white-space nowrap

    .gcode
      flex 1
      min-height 0
      position relative
      border-top 1px solid border-color

      .CodeMirror
        position absolute
        top 0
        right 0
        bottom 0
        left 0
        height auto

  .mdi
    white-space nowrap
    padding 0.125em
    display flex
    border-top 1px solid border-color

    > *
      margin 0.125em

    input
      flex 1
      min-width 0
      font-family mono-font

  .viewer-panel
    flex 1
    position relative

    .path-viewer
      flex 1
      min-height 0

    .navbar
      img
        width 1.5em
        margin 0 0.25em

      .snap
        text-transform capitalize

      .nav-item
        align-items center

    // Centered on the 3D view rather than the window
    .loading-message
      position absolute
      top 50%
      left 50%
      margin 0
      transform translate(-50%, -50%)

  .jog
    text-align center

    > svg
      margin 1em

      &.disabled
        opacity 0.4
        pointer-events none
        cursor not-allowed

  .jog-adjust
    text-align center
    margin-bottom 1em

    input
      margin 0 0.5em
      vertical-align middle

.load-on
  background-color ok-tint
  color text-color
@media only screen and (max-width 970px)
  .view-control #control
    .top-panels
      flex-direction column
      height auto
      min-height 0

    .program-panel
      flex-basis auto
      height 400px

    .viewer-panel
      flex-basis auto
      height 60vh
      min-height 300px

@media only screen and (max-width 940px)
  .view-control #control
    .axes
      .axis
        .name, .position
          font-size 18pt
          line-height 18pt

      .absolute, .offset
        display none


    .info-blocks
      grid-template-columns auto

