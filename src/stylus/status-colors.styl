.button-success:not([disabled])
  background-color ok-color
  border-color ok-color
  color #fff

.button-error:not([disabled])
  background-color err-color
  border-color err-color
  color #fff

.button-warning:not([disabled])
  background-color warn-color
  border-color warn-color
  color #fff

.button-secondary:not([disabled])
  background-color accent
  border-color accent
  color #fff

.error
  background err-color
  color #fff

.warn
  background warn-color

.success
  background ok-color
  color #fff

.fa.error
  background inherit
  color err-color

.fa.warn
  background inherit
  color warn-color

.fa.success
  background inherit
  color ok-color
